<.flash_group flash={@flash} />
<section class="p-4">
  <div class="m-auto">
    <h2 class="font-serif tracking-wide text-center mb-4 text-4xl">Weekly League Nights</h2>

    <div class="flex flex-wrap gap-3 justify-evenly">
      <div class="rounded-xl max-w-[40vw] bg-white p-4 text-center shadow-[0_5px_15px_rgba(0,0,0,0.12)] lg:px-6">
        <img
          class="mx-auto block h-28 w-40 object-contain"
          src="images/infinity-logo.png"
          alt="Infinity Game Lounge Logo"
        />

        <h3>Infinity Game Lounge</h3>

        <p>Mondays <strong>7:00 PM</strong></p>
      </div>
      <div class="rounded-xl max-w-[40vw] bg-white p-4 text-center shadow-[0_5px_15px_rgba(0,0,0,0.12)] lg:px-6">
        <img
          class="mx-auto block h-28 w-40 object-contain"
          src="images/game-lodge-logo.jpg"
          alt="The Game Lodge Logo"
        />

        <h3>The Game Lodge</h3>

        <p>Tuesdays <strong>6:00 PM</strong></p>
      </div>

      <div class="rounded-xl max-w-[40vw] bg-white p-4 text-center shadow-[0_5px_15px_rgba(0,0,0,0.12)] lg:px-6">
        <img
          class="mx-auto block h-28 w-40 object-contain"
          src="images/game-knight-logo.png"
          alt="Game Knight Logo"
        />

        <h3>Game Knight</h3>

        <p>Tuesdays <strong>6:00 PM</strong></p>
      </div>
      <div class="rounded-xl max-w-[40vw] bg-white p-4 text-center shadow-[0_5px_15px_rgba(0,0,0,0.12)] lg:px-6">
        <img
          class="mx-auto block h-28 w-40 object-contain"
          src="images/mid-tn-gaming-logo.png"
          alt="Middle TN Gaming Logo"
        />

        <h3>Middle TN Gaming</h3>

        <p>Thursdays <strong>7:00 PM</strong></p>
      </div>
    </div>
  </div>
</section>

<section class="p-4">
  <div class="m-auto">
    <div class="flex flex-col gap-[30px] md:flex-row md:items-stretch">
      <div class="max-w-full rounded-xl bg-white p-4 md:max-w-[75%]">
        <h3 class="font-serif text-[2rem] text-[#d65618]">$2,000+ IN PRIZING</h3>

        <ul class="list-disc ml-[25px] text-[1.2rem]">
          <li>
            🥇 1st: $300 + Foil Champion Playmat + 4x Signed Faerie Macabres + Hobbit Booster Box + Reality Fracture
            Booster Box
          </li>
          <li>
            🥈 2nd: $150 + 4x Signed Arbor Elf + Reality Fracture Booster Box + Custom Playmat
          </li>
          <li>🥉 3rd-4th: $75 + Reality Fracture Booster Box + Custom Playmat</li>
          <li>Top 8: Reality Fracture Booster Box + Custom Playmat</li>
          <li>Top 16: Custom Playmat</li>
          <li>Additional prizing added based on attendance.</li>
        </ul>
      </div>
      <div class="order-2 flex flex-1 flex-col justify-center rounded-xl bg-white p-4 text-center shadow-[0_5px_20px_rgba(0,0,0,0.1)] md:order-1">
        <h4 class="font-serif text-[2rem] text-[#d65618]">Every Player Receives</h4>
        <p class="m-0 text-[18px]">Custom Eldrazi Tokens</p>
        <img
          class="mx-auto block w-full max-w-40"
          src="images/eldrazi-tokens.png"
          alt="Eldrazi Token"
        />
      </div>
    </div>
  </div>
</section>

<section>
  <div class="m-auto">
    <div class="rounded-xl bg-[#47613E] p-4 text-white">
      <h2 class="mb-4 text-center text-[2.5rem]">How to Qualify</h2>

      <div class="mb-8 flex justify-center">
        <a
          class="inline-flex items-center gap-2 rounded-[10px] bg-white px-5 py-3 text-[24px] font-medium text-[#333] no-underline shadow-[0_2px_8px_rgba(0,0,0,0.15)] transition duration-200 ease-in-out hover:-translate-y-0.5 hover:shadow-[0_4px_12px_rgba(0,0,0,0.2)]"
          href="images/nrpl-poster.png"
        >
          Download League Info Flyer
        </a>
      </div>
      <ul class="list-disc ml-[25px] text-[20px]">
        <li><strong>League Points:</strong> Finish in the Top 12 at the end of the season.</li>

        <li><strong>Qualifier Event:</strong> Win a participating store's seasonal qualifier.</li>

        <li>
          Bonus Points:
          <ul class="list-disc ml-[25px] text-[20px]">
            <li>Attend events at 2 different stores in one month: +1 point</li>
            <li>Attend all 3 stores in one month: +2 points</li>
          </ul>
        </li>

        <li>Your lowest two weekly scores are dropped.</li>

        <li>Tiebreakers are based on attendance, then undefeated finishes.</li>

        <li>Winning multiple qualifier invitations awards a first-round bye.</li>
      </ul>
    </div>
  </div>
</section>
