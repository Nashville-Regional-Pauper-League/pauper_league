<.flash_group flash={@flash} />
<div class="rounded-xl mb-2 bg-white p-4 md:hidden">
  Compete in our weekly Magic: The Gathering Pauper Format events to earn a spot at the season invitational! See the
  <.link navigate={~p"/rules"} class="text-blue-600 underline hover:text-blue-800">
    rules page
  </.link>
  for more infomation.
</div>
<section class="p-0 min-[390px]:p-3">
  <div class="m-auto">
    <h2 class="font-serif tracking-wide text-center mb-4 text-3xl md:text-4xl">
      Weekly League Nights
    </h2>

    <div id="store-box" class="flex flex-wrap gap-2 justify-evenly text-sm sm:text-base">
      <%= for store <- @store_list do %>
        <.link navigate={store.url}>
          <div class="flex flex-2 sm:flex-1 flex-col justify-between rounded-xl bg-white hover:bg-slate-100 p-4 text-center shadow-[0_5px_15px_rgba(0,0,0,0.12)] max-w-[40vw] md:max-w-none md:px-8">
            <img
              class="mx-auto block object-contain h-28 w-40"
              src={store.logo}
              alt="#{store.name} Logo"
            />
            <h3 class="font-bold underline">{store.store}</h3>
            <div>
              <div>{store.league_night.day}</div>
              <strong>{store.league_night.time}</strong>
            </div>
            <div>
              <div>{store.address.line_1}</div>
              <div>{store.address.line_2}</div>
            </div>
          </div>
        </.link>
      <% end %>
    </div>
  </div>
</section>
<section class="p-4">
  <div class="flex items-center gap-4 mt-3">
    <div class="h-px flex-1 bg-slate-600"></div>

    <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-600">
      Upcoming Pauper Qualifiers
    </h2>

    <div class="h-px flex-1 bg-slate-600"></div>
  </div>
  <div class="overflow-hidden mt-4 rounded-2xl shadow-lg ring-1 ring-white/10">
    <.table id="event_list" rows={@qualifiers}>
      <:col :let={e} label="Store">{e.store}</:col>
      <:col :let={e} label="Date">{e.date}</:col>
    </.table>
  </div>
</section>
<section class="p-4">
  <div class="m-auto">
    <div class="flex flex-col gap-[30px] md:flex-row md:items-stretch">
      <div class="max-w-full md:max-w-[75%]">
        <div class="hidden rounded-xl mb-4 bg-white p-4 md:block">
          Compete in our weekly Magic: The Gathering Pauper Format events to earn a spot at the season invitational! See the
          <.link navigate={~p"/rules"} class="text-blue-600 underline hover:text-blue-800">
            rules page
          </.link>
          for more infomation.
        </div>
        <div class="rounded-xl bg-white p-4">
          <h3 class="font-serif text-[2rem] text-[#d65618]">PRIZING</h3>

          <ul class="list-disc ml-[25px] text-[1.2rem]">
            <li>
              🥇 1st: One-of-a-kind Champion Playmat + 4x Signed Faerie Macabres + Hobbit Booster Box
            </li>
            <li>
              🥈 2nd: Custom Playmat + 4x Signed Arbor Elf + Reality Fractured Booster Box
            </li>
            <li>🥉 3rd-8th: Custom Playmat + Reality Fractured Booster Box</li>
            <li>9th-16th: Custom Playmat</li>
            <li>Additional prizing may be added based on attendance.</li>
          </ul>
        </div>
      </div>
      <div class="order-2 flex flex-1 flex-col justify-center rounded-xl bg-white p-4 text-center shadow-[0_5px_20px_rgba(0,0,0,0.1)] md:order-1">
        <h4 class="font-serif text-[2rem] text-[#d65618]">Every Player Receives</h4>
        <p class="m-0 text-[18px]">Custom Eldrazi Tokens</p>
        <img
          class="mx-auto block w-full max-w-40"
          src="images/eldrazi-tokens.png"
          alt="Eldrazi Token"
        />
      </div>
    </div>
  </div>
</section>

<section>
  <div class="m-auto">
    <div class="rounded-xl bg-[#47613E] p-4 text-white">
      <h2 class="mb-4 text-center text-[2.5rem]">How to Qualify</h2>
      <ul class="list-disc ml-[25px] text-[20px]">
        <li><strong>League Points:</strong> Finish in the Top 12 at the end of the season.</li>

        <li><strong>Qualifier Event:</strong> Win a participating store's seasonal qualifier.</li>

        <li>
          Bonus Points:
          <ul class="list-disc ml-[25px] text-[20px]">
            <li>Attend events at 2 different stores in one month: +1 point</li>
            <li>Attend events at 3 different stores in one month: +2 point</li>
            <li>Attend all 4 stores in one month: +3 points</li>
            <li>A player must play all 3 rounds of the event to be awarded the bonus.</li>
            <li>
              There are 3 months in the first league: Aug. 24 - Sept. 30; Oct. 1 - Oct. 30; Nov. 1 - Dec. 12
            </li>
          </ul>
        </li>

        <li>Your lowest two weekly scores are dropped.</li>

        <li>Tiebreakers are based on attendance, then undefeated finishes.</li>

        <li>Winning multiple qualifier invitations awards a first-round bye.</li>
      </ul>
    </div>
  </div>
</section>
