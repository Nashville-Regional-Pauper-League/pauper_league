<header class="fixed z-50 w-full px-4 bg-[#47613E] sm:px-6 lg:px-24">
  <div class="flex items-center justify-between border-zinc-100 py-3 text-sm">
    <div class="flex items-center overflow-hidden">
      <div class="h-16 w-32">
        <.link navigate={~p"/"}>
          <img
            class="object-center rounded-lg object-cover w-full h-full"
            src={~p"/images/nrpl-logo.png"}
          />
        </.link>
      </div>
    </div>
    <%!-- <.link
      href={~p"/users/log_out"}
      method="delete"
      class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
    >
      Log out
    </.link> --%>
    <div class="hidden md:flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <.link
        navigate={~p"/leaderboard"}
        class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
      >
        Leaderboard
      </.link>
      <.link navigate={~p"/events"} class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80">
        Events
      </.link>
      <.link
        navigate={~p"/metagame"}
        class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
      >
        Metagame
      </.link>
      <%!-- <.link navigate={~p"/rules"} class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80">
        Rules
      </.link> --%>
      <.link
        navigate="https://discord.gg/vf7Sa36bd"
        class="rounded-lg text-[#5865F2] bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
      >
        Join our Discord!
      </.link>
    </div>
    <button
      type="button"
      id="mobile-menu-button"
      class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80 md:hidden"
      phx-click={JS.toggle(to: "#mobile-menu")}
      aria-label="Toggle navigation"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden px-4 pb-4 md:hidden">
    <div class="flex flex-col gap-2">
      <.link
        navigate={~p"/leaderboard"}
        class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
      >
        Leaderboard
      </.link>
      <.link navigate={~p"/events"} class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80">
        Events
      </.link>
      <.link
        navigate={~p"/metagame"}
        class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
      >
        Metagame
      </.link>
      <%!-- <.link navigate={~p"/rules"} class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80">
        Rules
      </.link> --%>
      <.link
        navigate="https://discord.gg/vf7Sa36bd"
        class="rounded-lg text-[#5865F2] bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
      >
        Join our Discord!
      </.link>
    </div>
  </div>
</header>
<main class="px-4 py-4 pt-24 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
